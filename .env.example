# Copie este arquivo para `.env` (para rodar local com `npx vercel dev`)
# e configure as mesmas variáveis no painel da Vercel (Settings → Environment Variables).

# Access Token do Mercado Pago.
# Teste: começa com TEST-    |    Produção: começa com APP_USR-
MP_ACCESS_TOKEN=APP_USR-cole-aqui-seu-access-token

# URL pública do site (usada para montar as voltas do checkout).
SITE_URL=https://suitehub.github.io/roupaodafe/

# Origens autorizadas a chamar a API (CORS), separadas por vírgula.
ALLOWED_ORIGINS=https://suitehub.github.io,http://localhost:8123

# URL pública deste webhook (o próprio projeto na Vercel).
# Usada no notification_url da preferência.
MP_WEBHOOK_URL=https://SEU-PROJETO.vercel.app/api/webhook

# Opcional: segredo de assinatura do webhook (painel do Mercado Pago).
# Se preencher, o /api/webhook passa a exigir assinatura válida.
MP_WEBHOOK_SECRET=
